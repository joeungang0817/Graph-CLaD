{
  "spec_version": "phase2.v2-draft",
  "status": "draft_for_phase2r",
  "supersedes_for_future_execution": "phase2.v1",
  "preserve_v1_as_static_baseline": true,
  "temporal_contract": {
    "primary_horizon_tau": 6,
    "evaluation_horizons": [1, 3, 6],
    "input": ["past_graph_sequence", "current_graph", "action_window"],
    "targets": ["future_relations", "future_latent_graph"],
    "optional_targets": ["object_displacement", "object_orientation"],
    "require_nonzero_action_coverage": true,
    "align_within_episode_only": true,
    "forbidden_features": ["future_state", "reward", "success", "terminal"]
  },
  "split": {
    "unit": "episode",
    "fit_normalization_on": "train_only",
    "calibrate_relation_thresholds_on": "train_only",
    "require_disjoint_episode_ids": true
  },
  "identity": {
    "alignment_key": "logical_id",
    "logical_id_is_model_feature": false,
    "body_id_usage": "runtime_audit_only"
  },
  "node_policy": {
    "primary_types": ["robot", "object", "fixture", "task_relevant_site"],
    "primary_selection": "task_relevant_entities_only",
    "all_sites_variant": "ablation_only",
    "exclude_from_core_features": ["is_object_of_interest", "task_id", "logical_name"],
    "oracle_feature_ablations": ["is_object_of_interest"]
  },
  "coordinate_frame": {
    "primary": "robot_base",
    "status": "stable_for_libero_spatial_task0_pilot; recheck across task families before scale_up",
    "transform_source": "sim body robot0_base pose per episode",
    "audit": "raw_world",
    "axis_semantics_required": true,
    "axis_semantics_status": "inherits robot0_base axes; relation polarity must be checked against task/camera convention"
  },
  "node_features": {
    "required": [
      "position",
      "position_valid",
      "node_type_one_hot",
      "robot_gripper_state",
      "robot_joint_state",
      "feature_validity_masks"
    ],
    "optional_ablations": ["rotation_6d", "object_of_interest_oracle_flag"],
    "quaternion_policy": "verify_runtime_order_before_rotation_6d_conversion"
  },
  "relations": {
    "independent_binary_labels": true,
    "pairwise_relation_labels": ["left", "right", "front", "behind", "above", "below", "contact", "on", "inside", "holding"],
    "node_state_labels": ["open", "close"],
    "loss_family": "masked_binary_cross_entropy",
    "labels": [
      "left",
      "right",
      "front",
      "behind",
      "above",
      "below",
      "contact",
      "on",
      "inside",
      "holding",
      "open",
      "close"
    ],
    "record_per_label": ["value", "valid", "definition_version"],
    "unknown_is_false": false,
    "semantic_handler_policy": {
      "on": "LIBERO check_ontop when available, otherwise captured-AABB fallback",
      "inside": "target-side LIBERO check_contain when available, otherwise captured-AABB fallback",
      "holding": "robot contact plus calibrated closed-gripper state; unknown without both",
      "open": "node-level state only; not duplicated across directed edges",
      "close": "node-level state only; not duplicated across directed edges"
    },
    "consistency_rules": [
      "left(i,j)=right(j,i)",
      "front(i,j)=behind(j,i)",
      "above(i,j)=below(j,i)",
      "contact(i,j)=contact(j,i)"
    ]
  },
  "topology_variants": {
    "paper_faithful_baseline": {
      "topology": "complete_directed_without_self_loops",
      "input_edge_features": "empty"
    },
    "geometry_edge_variant": {
      "topology": "complete_directed_without_self_loops",
      "input_edge_features": ["target_minus_source_position", "distance", "validity"]
    },
    "learned_edge_variant": {
      "topology": "complete_directed_without_self_loops",
      "input_edge_features": "learned_soft_attention"
    },
    "controls": [
      "no_message_passing",
      "shuffled_sender_receiver",
      "no_action",
      "shuffled_action",
      "all_sites"
    ]
  },
  "model_targets": {
    "primary": "post_action_relation_classification",
    "secondary": ["current_relation_classification", "latent_graph_consistency"],
    "optional": ["contrastive_graph_dynamics", "pose_regression"]
  },
  "evaluation": {
    "metrics": [
      "macro_relation_f1",
      "per_relation_f1",
      "changed_relation_precision_recall_f1",
      "horizon_1_3_6",
      "parameter_count",
      "seed_variance"
    ],
    "primary_metric": "post_action_changed_relation_f1",
    "required_baseline": "parameter_matched_mlp_with_feature_parity"
  },
  "required_tests": [
    "node_permutation_equivariance",
    "logical_id_temporal_alignment",
    "relation_inverse_and_symmetry_consistency",
    "variable_node_count_and_padding_mask",
    "action_target_temporal_alignment",
    "no_future_leakage",
    "episode_split_isolation",
    "multi_step_unroll_and_mask_shapes",
    "control_input_mutation",
    "gnn_mlp_feature_parity"
  ]
}
