{
  "protocol": "phase3c-oracle-graph-clad-core-seed0-v1",
  "schema": "phase3c-joined-sample.v1",
  "tau": 6,
  "relations": [
    "left",
    "right",
    "front",
    "behind",
    "above",
    "below",
    "contact",
    "on"
