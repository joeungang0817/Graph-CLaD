  "input_blacklist": [
    "graph_target",
    "future_graph",
    "future_action",
    "action_future",
    "action_window_future",
    "reward",
    "success",
    "is_object_of_interest",
    "task_semantics",
    "bddl",
    "goal",
    "goal_state",
    "relation_changes"
  ],
  "notes": {
    "semantic_encoder": "DecisionNCE-P is a controlled reimplementation assumption; record repository/checkpoint SHA.",
    "holding": "excluded from Phase 3C loss, checkpoint, threshold, model selection, and gate until audit completion",
    "future_action": "right sample action_window is never copied into the joined model-input record"
  }
}
