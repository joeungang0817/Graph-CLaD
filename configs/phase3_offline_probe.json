{
  "probe_version": "phase3-offline.v1",
  "models": [
    "p0_flat_mlp",
    "p1_node_no_message",
    "p2_gnn_empty_edge",
    "p3_gnn_geometry",
    "p4_gnn_soft_attention"
  ],
  "seeds": [0, 1, 2],
  "hidden_dim": 64,
  "batch_size": 64,
  "epochs": 40,
  "patience": 8,
  "learning_rate": 0.001,
  "current_loss_weight": 0.25,
  "device": "auto",
  "primary_metric": "test.changed_relation.macro_f1",
  "secondary_metrics": [
    "test.future_relation.macro_f1",
    "per_relation_f1",
    "no_action_delta",
    "shuffled_action_delta",
    "shuffled_edge_delta",
    "parameter_count",
    "seed_mean_std"
  ],
  "dataset_contract": {
    "coordinate_frame": "robot_base",
    "graph_site_policy": "include_all_sites",
    "episode_split_required": true,
    "normalization_fit": "train_only",
    "future_input_forbidden": true,
    "target_relations": [
      "left",
      "right",
      "front",
      "behind",
      "above",
      "below",
      "contact",
      "on",
      "inside",
      "holding"
    ]
  },
  "deferred_models": {
    "p5_recurrent_history": "requires full past graph sequence in Phase 2R samples"
  }
}
